# Flask Configuration
PORT=5000
FLASK_ENV=development

# Tesseract OCR Configuration (Windows path)
# Default common paths: D:\Tesseract\tesseract.exe or C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=D:\Tesseract\tesseract.exe

# AI Vision Provider Configuration (Optional)
# Supported providers: 'gemini' (default) or 'openai'
AI_PROVIDER=gemini

# Google Gemini Vision API Configuration
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Vision API Configuration (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
